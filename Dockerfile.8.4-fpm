# syntax=docker/dockerfile:1.6
FROM debian:trixie-slim AS shim-builder
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends gcc libc6-dev; \
    rm -rf /var/lib/apt/lists/*
COPY ./shim/chmod-sanitize.c /tmp/chmod-sanitize.c
RUN gcc -shared -fPIC -O2 -Wall -o /tmp/php-chmod-sanitize.so /tmp/chmod-sanitize.c -ldl

FROM php:8.4-fpm-trixie

ENV DEBIAN_FRONTEND=noninteractive

RUN set -eux; \
    apt-get update; \
    apt-get upgrade -y; \
    apt-get install -y --no-install-recommends \
    jq \
    libfcgi-bin \
    mariadb-client \
    nano \
    rsync \
    zip \
    zstd; \
    curl -sSLf -o /usr/local/bin/install-php-extensions \
    https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions; \
    chmod +x /usr/local/bin/install-php-extensions; \
    install-php-extensions \
    bcmath \
    exif \
    gd \
    igbinary \
    imagick \
    intl \
    memcached \
    mysqli \
    opcache \
    pcntl \
    pdo_mysql \
    pdo_pgsql \
    redis \
    soap \
    zip \
    zstd; \
    rm /usr/local/bin/install-php-extensions; \
    curl -sSLf -o /usr/local/bin/php-fpm-healthcheck \
    https://raw.githubusercontent.com/renatomefi/php-fpm-healthcheck/master/php-fpm-healthcheck; \
    chmod +x /usr/local/bin/php-fpm-healthcheck; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

COPY --from=shim-builder /tmp/php-chmod-sanitize.so /usr/local/lib/php-chmod-sanitize.so

COPY ./conf/php.ini /usr/local/etc/php/conf.d/01-php.ini
COPY ./conf/www.conf /usr/local/etc/php-fpm.d/www.conf

HEALTHCHECK --interval=5s --timeout=1s --start-period=3s --retries=3 CMD php-fpm-healthcheck || exit 1

STOPSIGNAL SIGQUIT

USER www-data

WORKDIR /app

# List of supported extensions available here:
# https://github.com/mlocati/docker-php-extension-installer#readme
